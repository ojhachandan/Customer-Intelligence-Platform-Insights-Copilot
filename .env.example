# Database Credentials (PostgreSQL)
POSTGRES_DB=YOUR_POSTGRES_DB_NAME
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# Service Connections
CIP_DATABASE_URL=postgresql+psycopg://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/YOUR_POSTGRES_DB_NAME
CIP_REDIS_URL=redis://localhost:6379/0
CIP_QDRANT_URL=http://localhost:6333
CIP_MLFLOW_TRACKING_URI=http://localhost:5000
CIP_OLLAMA_BASE_URL=http://localhost:11434
CIP_OLLAMA_MODEL=llama3.2:3b
CIP_OPENAI_COMPATIBLE_BASE_URL=
CIP_OPENAI_COMPATIBLE_API_KEY=
CIP_FEATURE_VERSION=rfm-behavior-affinity-v1
CIP_RECOMMENDATION_VERSION=hybrid-v1
CIP_TOP_K=10

# Currency conversion rate from USD to INR
USD_TO_INR=94.68
